@inproceedings{ives_sideways_2008,
	title = {Sideways {Information} {Passing} for {Push}-{Style} {Query} {Processing}},
	url = {https://ieeexplore.ieee.org/document/4497486},
	doi = {10.1109/ICDE.2008.4497486},
	abstract = {In many modern data management settings, data is queried from a central node or nodes, but is stored at remote sources. In such a setting it is common to perform "push- style" query processing, using multithreaded pipelined hash joins and bushy query plans to compute parts of the query in parallel; to avoid idling, the CPU can switch between them as delays are encountered. This works well for simple select-project- join queries, but increasingly, Web and integration applications require more complex queries with multiple joins and even nested subqueries. As we demonstrate in this paper, push-style execution of complex queries can be improved substantially via sideways information passing; push-style queries provide many opportunities for information passing that have not been studied in the past literature. We present adaptive information passing, a general runtime decision-making technique for reusing intermediate state from one query subresult to prune and reduce computation of other subresults. We develop two alternative schemes for performing adaptive information passing, which we study in several settings under a variety of workloads.},
	urldate = {2025-01-27},
	booktitle = {2008 {IEEE} 24th {International} {Conference} on {Data} {Engineering}},
	author = {Ives, Zachary G. and Taylor, Nicholas E.},
	month = apr,
	year = {2008},
	note = {ISSN: 2375-026X},
	keywords = {notion, Query processing, Engines, Delay, Concurrent computing, Decision making, Distributed databases, Information science, Peer to peer computing, Runtime, Switches},
	pages = {774--783},
	file = {IEEE Xplore Abstract Record:/Users/paul/Zotero/storage/4XCUFEXH/4497486.html:text/html;Submitted Version:/Users/paul/Zotero/storage/RDTNFVVH/Ives and Taylor - 2008 - Sideways Information Passing for Push-Style Query .pdf:application/pdf},
}

@article{chen_applying_1997,
	title = {On applying hash filters to improving the execution of multi-join queries},
	volume = {6},
	issn = {0949-877X},
	url = {https://doi.org/10.1007/s007780050036},
	doi = {10.1007/s007780050036},
	abstract = {In this paper, we explore an approach of interleaving a bushy execution tree with hash filters to improve the execution of multi-join queries. Similar to semi-joins in distributed query processing, hash filters can be applied to eliminate non-matching tuples from joining relations before the execution of a join, thus reducing the join cost. Note that hash filters built in different execution stages of a bushy tree can have different costs and effects. The effect of hash filters is evaluated first. Then, an efficient scheme to determine an effective sequence of hash filters for a bushy execution tree is developed, where hash filters are built and applied based on the join sequence specified in the bushy tree so that not only is the reduction effect optimized but also the cost associated is minimized. Various schemes using hash filters are implemented and evaluated via simulation. It is experimentally shown that the application of hash filters is in general a very powerful means to improve the execution of multi-join queries, and the improvement becomes more prominent as the number of relations in a query increases.},
	language = {en},
	number = {2},
	urldate = {2025-01-27},
	journal = {The VLDB Journal},
	author = {Chen, Ming-Syan and Hsiao, Hui-I and Yu, Philip S.},
	month = may,
	year = {1997},
	keywords = {notion, Key words: Hash filters – Parallel query processing – Bushy trees – Sort-merge joins},
	pages = {121--131},
	file = {Full Text PDF:/Users/paul/Zotero/storage/62ILWB3G/Chen et al. - 1997 - On applying hash filters to improving the executio.pdf:application/pdf},
}

