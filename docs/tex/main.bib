@inproceedings{vogelsgesang_get_2018,
	address = {New York, NY, USA},
	series = {{DBTest} '18},
	title = {Get {Real}: {How} {Benchmarks} {Fail} to {Represent} the {Real} {World}},
	isbn = {978-1-4503-5826-2},
	shorttitle = {Get {Real}},
