	file = {arXiv Fulltext PDF:/Users/paul/Zotero/storage/PF2T7JUU/Gupta et al. - 2021 - Columnar Storage and List-based Processing for Gra.pdf:application/pdf;arXiv.org Snapshot:/Users/paul/Zotero/storage/5AKL7TID/2103.html:text/html},
}

