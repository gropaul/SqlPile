	keywords = {Computer Science - Databases},
	file = {arXiv Fulltext PDF:/Users/paul/Zotero/storage/RMLW8NLC/Aberger et al. - 2017 - EmptyHeaded A Relational Engine for Graph Process.pdf:application/pdf;arXiv.org Snapshot:/Users/paul/Zotero/storage/PLHVXLWR/1503.html:text/html},
}

