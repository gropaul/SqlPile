	keywords = {notion, Computer Science - Databases},
	file = {arXiv Fulltext PDF:/Users/paul/Zotero/storage/LLSG5IV4/Atserias et al. - 2017 - Size bounds and query plans for relational joins.pdf:application/pdf;arXiv.org Snapshot:/Users/paul/Zotero/storage/85A8VUQV/1711.html:text/html},
}

@misc{ammar_distributed_2018,
	title = {Distributed {Evaluation} of {Subgraph} {Queries} {Using} {Worstcase} {Optimal} {LowMemory} {Dataflows}},
